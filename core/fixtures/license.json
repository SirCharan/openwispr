{
  "cases": [
    {"name": "fresh install needs a key", "event": "launch", "expect": "unlicensed"},
    {"name": "activate 200", "event": "activated", "expect": "active"},
    {"name": "activate 404", "event": "http_404", "expect": "invalid"},
    {"name": "activate 403", "event": "http_403", "expect": "revoked"},
    {"name": "activate 422 leaves state, reports error", "event": "http_422", "expect": "unlicensed", "expect_error": true},
    {"name": "validated 6 days ago, no call", "validated_days_ago": 6, "event": "launch", "expect": "active", "expect_due": false},
    {"name": "validated 8 days ago, due", "validated_days_ago": 8, "event": "launch", "expect": "active", "expect_due": true},
    {"name": "8 days ago + network error", "validated_days_ago": 8, "event": "network", "expect": "grace:13"},
    {"name": "22 days ago + network error", "validated_days_ago": 22, "event": "network", "expect": "lapsed"},
    {"name": "network error inside 7 days stays active", "validated_days_ago": 3, "event": "network", "expect": "active"},
    {"name": "valid:false revokes", "validated_days_ago": 8, "event": "valid_false", "expect": "revoked"},
    {"name": "valid:true refreshes", "validated_days_ago": 8, "event": "valid_true", "expect": "active", "expect_due": false},
    {"name": "future lastValidatedAt is due now", "validated_days_ago": -3, "event": "launch", "expect": "active", "expect_due": true},
    {"name": "deactivate returns to unlicensed", "validated_days_ago": 1, "event": "deactivated", "expect": "unlicensed"}
  ],
  "gate": [
    {"state": "unlicensed", "dictate": false, "meet": false},
    {"state": "trial:3", "dictate": false, "meet": false},
    {"state": "trialExpired", "dictate": false, "meet": false},
    {"state": "active", "dictate": true, "meet": true},
    {"state": "grace:5", "dictate": true, "meet": true},
    {"state": "lapsed", "dictate": false, "meet": false},
    {"state": "revoked", "dictate": false, "meet": false},
    {"state": "invalid", "dictate": false, "meet": false}
  ]
}
